{
  "name": "zgnn",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev --turbopack --port 7727",
    "build": "next build --webpack && node scripts/check-bundle.mjs",
    "preview": "serve out -l 7727",
    "lint": "eslint .",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "data:pull": "node scripts/pull-db.mjs",
    "data:login": "node scripts/login.mjs",
    "data:logout": "node scripts/logout.mjs",
    "data:seed": "node scripts/seed-db.mjs",
    "data:collect": "node scripts/collect-blog.mjs",
    "data:analyze": "node scripts/analyze-candidates.mjs",
    "data:homepage": "node scripts/fill-homepage.mjs",
    "data:apply": "node scripts/apply-approved.mjs",
    "data:review": "node --experimental-strip-types --no-warnings scripts/review-candidates.mjs",
    "data:eval": "node --experimental-strip-types --no-warnings --import ./scripts/lib/tsExtResolve.mjs scripts/eval-extract.mjs",
    "data:fetch-images": "node scripts/fetch-blog-images.mjs",
    "data:optimize-images": "node scripts/optimize-images.mjs",
    "data:normalize": "node scripts/normalize.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@untitledui/icons": "^0.0.22",
    "next": "^16.3.5",
    "react": "^19.2.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.5",
    "globals": "^16.4.0",
    "postcss": "^8.5.8",
    "serve": "^14.2.6",
    "serwist": "^9.5.12",
    "sharp": "^0.35.4",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.1.13",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "supabase",
      "unrs-resolver"
    ]
  }
}
