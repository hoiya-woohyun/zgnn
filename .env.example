# 로컬은 .env.local 에 복사(gitignored). 스크립트는 node --env-file-if-exists=.env.local 로 읽는다.
# 이름만 적고 값은 비워 둔다 — 실제 값은 커밋하지 않는다.

SUPABASE_URL=                      # 빌드(data:pull)·GitHub Actions. 공개돼도 무방
SUPABASE_SERVICE_ROLE_KEY=         # RLS 우회 키. 절대 NEXT_PUBLIC_ 금지·커밋 금지. Vercel(Sensitive)·GitHub Secrets
NAVER_CLIENT_ID=                   # 02 수집. GitHub Secrets 만
NAVER_CLIENT_SECRET=               # 02 수집. GitHub Secrets 만
CLAUDE_CODE_OAUTH_TOKEN=           # 03 분석(Actions 전용). `claude setup-token` 으로 발급 — 구독 계정 자체라 GitHub Secrets 에만. 로컬은 비워 둔다(claude 로그인을 쓴다)
KAKAO_REST_API_KEY=                # 03 좌표 보강. 지도 JS 키와 다른 키. 없으면 data:analyze 가 좌표 보강만 건너뛴다
ANALYZE_MODEL=                     # (선택) 03 분석 모델 덮어쓰기. 비우면 claude-opus-5. 첫 1년치 대량 처리 때 haiku 비교용
NEXT_PUBLIC_KAKAO_MAP_KEY=         # 지도 JS 키(src/lib/kakaoMap.ts). 유일하게 공개 전제 — 코드에 기본값이 있어 비워도 된다. 도메인 제한이 방어선
